{
  "name": "nn-auth-be",
  "version": "1.0.0",
  "description": "NN Auth System — Backend Express.js + TypeScript + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:status": "drizzle-kit status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.40.1",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "8.0.4",
    "pg": "8.20.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.39",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "2.1.9",
    "drizzle-kit": "0.30.6",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
